{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": ["vite/client", "node"]
  },
  "include": ["src", "vite.config.ts", "tools/check_coordinates.ts", "tools/check_match.ts", "tools/check_ship_animation.ts", "tools/check_fog.ts", "tools/check_ports.ts", "tools/check_ai.ts"]
}
